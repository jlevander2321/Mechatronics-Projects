PROGRAM main
  VAR
    START : BOOL AT %IX0.0; (* Start pushbutton, GPIO 18, pull-down. 1 = pressed. *)
    STOP : BOOL AT %IX0.1; (* Stop pushbutton, GPIO 19, pull-down. 1 = pressed. Used as an NC contact in Rung 1, so pressing it breaks the seal. *)
    LED : BOOL AT %QX0.0; (* Run indicator LED, GPIO 5. 1 = lit. Flashes while the machine is running. *)
    RUN : BOOL; (* Internal run bit, no physical I/O. 1 = machine running. Set by Start, cleared by Stop (Rung 1). *)
    T1_DONE : BOOL; (* Internal bit. 1 = flasher timer T1 done, LED on phase (Rung 2). *)
    T2_DONE : BOOL; (* Internal bit. 1 = flasher timer T2 done, resets T1 (Rung 3). *)
    T1 : TON; (* Flasher timer 1, TON 500 ms. Times the LED off phase. *)
    T2 : TON; (* Flasher timer 2, TON 500 ms. Times the LED on phase. *)
  END_VAR

